{
  "name": "@wecom/wecom-openclaw-plugin",
  "version": "2026.8.17",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "release": "node scripts/publish-all.mjs",
    "release:dry": "node scripts/publish-all.mjs --dry-run",
    "release:ci": "node scripts/publish-all.mjs --yes --restore=no",
    "deploy:local": "bash scripts/dev-deploy.sh",
    "deploy:local:extensions": "bash scripts/dev-deploy.sh --target=extensions"
  },
  "keywords": [
    "wecom",
    "openclaw",
    "wecom-openclaw-plugin"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WecomTeam/wecom-openclaw-plugin.git"
  },
  "homepage": "https://github.com/WecomTeam/wecom-openclaw-plugin#readme",
  "bugs": {
    "url": "https://github.com/WecomTeam/wecom-openclaw-plugin/issues"
  },
  "description": "OpenClaw WeCom (企业微信) channel plugin (official by Tencent WeCom team)",
  "openclaw": {
    "compat": {
      "pluginApi": ">=2026.8.1-beta.3"
    },
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "wecom",
      "label": "企业微信",
      "selectionLabel": "企业微信 (WeCom)",
      "docsPath": "/channels/wecom",
      "docsLabel": "wecom-openclaw-plugin",
      "blurb": "企业微信机器人接入插件",
      "order": 80,
      "quickstartAllowFrom": true,
      "setup": {
        "fields": [
          {
            "key": "token",
            "kind": "string",
            "cli": {
              "flags": "--token <value>",
              "description": "WeCom bot ID"
            }
          },
          {
            "key": "privateKey",
            "kind": "string",
            "sensitive": true,
            "cli": {
              "flags": "--private-key <value>",
              "description": "WeCom bot secret"
            }
          }
        ]
      }
    },
    "install": {
      "npmSpec": "@wecom/wecom-openclaw-plugin",
      "localPath": "extensions/wecom-openclaw-plugin",
      "defaultChoice": "npm"
    }
  },
  "dependencies": {
    "@wecom/aibot-node-sdk": "^1.0.6",
    "@wecom/cli": "^1.0.0",
    "fast-xml-parser": "^5.5.9",
    "file-type": "^21.3.0",
    "undici": "^7.24.6"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.1-beta.3"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "openclaw": "2026.8.1-beta.3",
    "typescript": "^5.3.3",
    "vitest": "^4.1.1"
  }
}
